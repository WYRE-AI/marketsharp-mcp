# Single-tenant credentials (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode compose service does not load these. Do not add them to
# that service's environment or via env_file.
MARKETSHARP_COMPANY_ID=
MARKETSHARP_API_KEY=
MARKETSHARP_API_SECRET=
# Optional. Search and note tools need an employee in the token.
MARKETSHARP_EMPLOYEE_ID=

# Every tool is read-only; there is no write tier. Conduit's
# X-Conduit-Tool-Tiers request header can only narrow the "read" tier (an
# empty header means no tools).

# stdio (default) or http
MCP_TRANSPORT=stdio

# Bind address for HTTP. When CONDUIT_S2S_SECRET is set and MCP_HTTP_HOST is
# unset, the server binds 0.0.0.0 (container deploys). Set 127.0.0.1 to bind
# loopback. The insecure-dev bypass ignores a non-loopback value and binds
# 127.0.0.1 only.
# MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080

# Required to start the HTTP transport. The process exits non-zero when this
# is empty or a known placeholder (changeme, change-me, secret, example,
# placeholder, replace-me, your-secret, your-s2s-secret, s2s-secret,
# replace-with-a-real-secret), so a copied example cannot forge X-Gateway-S2S.
# Generate a value with: openssl rand -hex 32
# Must be at least 32 characters, or the server refuses to start.
# Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. Requires NODE_ENV=development; with any other NODE_ENV
# the server refuses to start. The server logs a warning, does not check
# X-Gateway-S2S, and binds 127.0.0.1 only.
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP. Unset means gateway.
#   gateway (default): required x-marketsharp-company-id / -api-key /
#     -api-secret headers, optional x-marketsharp-employee-id. MARKETSHARP_*
#     env is never read.
#   env: single tenant, credentials from MARKETSHARP_* in the environment.
# Any other value refuses to start HTTP. Stdio reads MARKETSHARP_* only when
# this is unset or exactly env. The Docker image sets AUTH_MODE=gateway, so
# running the image over stdio needs AUTH_MODE=env (and MCP_TRANSPORT=stdio).
# AUTH_MODE=env

LOG_LEVEL=info
